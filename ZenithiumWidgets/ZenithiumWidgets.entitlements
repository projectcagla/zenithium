<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The extension reads the App-Group snapshot and nothing else. It deliberately does
	     not carry the HealthKit entitlement: ASSUMPTION WIDGET-1 keeps widgets on the JSON
	     file, so the extension has no reason to touch Health. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.cagla.zenithium</string>
	</array>
</dict>
</plist>
