<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Zenithium</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>

	<!-- Spec §8. Shown on the HealthKit permission sheet. -->
	<key>NSHealthShareUsageDescription</key>
	<string>Zenithium uykunu, nabzını, HRV'ni, dinlenme nabzını, solunum hızını, bilek sıcaklığını ve antrenmanlarını okuyarak ne kadar toparlandığını ve bugün ne kadar yüklenebileceğini hesaplar. Hepsi bu cihazda kalır; hiçbir yere gönderilmez.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Zenithium antrenman seanslarını ve toparlanma analizlerini Sağlık uygulamanızla senkronize etmek için sağlık verilerini günceller.</string>

	<!-- Spec §8, ASSUMPTION BG-1. Must match BackgroundRefreshScheduler.taskIdentifier. -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.zenithium.refresh.daily</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>processing</string>
	</array>

	<!-- Dark mode lock gerekçesi:
	     Zenithium tıbbi/atletik hassasiyet arayüzüdür. Gece ölçümleri,
	     sirkadiyen ritim takibi ve OLED piksel başına güç tasarrufu için
	     karanlık tema zorunludur. Apple HIG 'uygulamanızın teması içeriğin
	     doğasından kaynaklanıyorsa tek tema meşrudur' istisnası. -->
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>

	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>background</string>
	</dict>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>

	<!-- §12: no network entitlement, no analytics, no third-party SDK. There is deliberately
	     no NSAppTransportSecurity dictionary here, because the app makes no network requests
	     to configure. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Yol haritası v4, C10 — the Live Activity for a session running on the watch. -->
	<key>NSSupportsLiveActivities</key>
	<true/>
</dict>
</plist>
